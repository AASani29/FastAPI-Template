# Copy to `.env` and fill in. `.env` is gitignored and is the ONLY place
# secrets live — nothing in this repo has a hardcoded credential or key.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The +asyncpg suffix picks SQLAlchemy's async driver. A plain
# postgresql:// URL silently selects psycopg2 and fails at startup.
#
# Local (docker compose up db):
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/app
#
# Supabase: use the SESSION or TRANSACTION POOLER string from
# Project Settings -> Database -> Connection string, NOT the direct one.
# The direct host (db.<ref>.supabase.co) resolves to IPv6 only on newer
# projects and will fail from most home and CI networks.
#   DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Separate database for the test suite. conftest.py creates and drops the whole
# schema here on every run, so it must NEVER point at a database you care about.
TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/app_test

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate a real one, do not ship this placeholder:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Anyone holding this value can mint a valid token for any user.
JWT_SECRET=change-me-before-you-run-this-anywhere-real
JWT_ALGORITHM=HS256
# 60 minutes is a deliberate middle ground: short enough that a token stolen
# from localStorage expires on its own, long enough to survive a demo without
# a refresh-token flow. See the JWT storage trade-off in the README.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated. Must list the Vite dev origin exactly (scheme + port);
# a browser treats http://localhost:5173 and http://127.0.0.1:5173 as different
# origins and will block the one that is not listed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Add your own domain-specific env vars here as the app grows, and a matching
# field on Settings in app/core/config.py — that's the one place a tunable
# constant belongs, never scattered inline at a call site.

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Echoes every generated SQL statement. Useful when a query misbehaves, far too
# noisy to leave on.
SQL_ECHO=false
